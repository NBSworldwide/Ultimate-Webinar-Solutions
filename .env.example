APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional server-side Google Places API key for the map widget's place card and review summary.
GOOGLE_PLACES_API_KEY=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# One-time first-administrator bootstrap. Never commit real values or use this to replace an existing admin.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Webinar Administrator
# Set true when promoting an already-created first account; it prevents accidental account creation on a typo.
INITIAL_ADMIN_EXISTING_ACCOUNT_ONLY=false
# Used to encrypt provider credentials stored through Admin > Settings.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters-long
DEMO_MODE=true
# Local-only synthetic role accounts. Set all three before running pnpm db:seed-users.
# Use unique values of at least 20 characters; never set these in production.
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_CUSTOMER_PASSWORD=
# Required confirmation for the local-only demo-user seed command.
DEMO_USER_SEED_CONFIRMATION=
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_WORKER_SECRET=replace-with-a-random-worker-secret
# Required only when SMS_PROVIDER=twilio and SMS_ENABLED=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Vercel Cron sends CRON_SECRET as a bearer token to the scheduled route.
CRON_SECRET=
